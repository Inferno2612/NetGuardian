{
  "manifest_version": 3,
  "name": "NetGuardian — блокировка без VPN",
  "version": "1.0.0",
  "description": "Блокирует переход на выбранные сайты, если VPN (Hiddify/Amnezia) через NetGuardian выключен",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["nativeMessaging", "webNavigation", "storage", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "netguardian@localhost",
      "strict_min_version": "109.0"
    }
  }
}
